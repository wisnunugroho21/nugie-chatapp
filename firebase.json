{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "functions/**",
      "**/.*",
      "**/node_modules/**",
      "*.md"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/main.html"
      }
    ]
  }
}
